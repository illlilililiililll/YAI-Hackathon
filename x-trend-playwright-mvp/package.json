    "dotenv": "17.4.2",
    "openai": "6.49.0",
    "parse5": "8.0.1",
    "postcss": "8.5.25",
    "undici": "7.21.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "esbuild": "0.28.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
